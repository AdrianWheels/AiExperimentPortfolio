---
import { ViewTransitions } from 'astro:transitions'
import BaseHead from '../components/layout/BaseHead.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import { getLocaleFromUrl } from '../i18n'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  image?: string
  canonicalURL?: string
  type?: 'website' | 'article'
  schema?: Record<string, unknown>
}

const { title, description, image, canonicalURL, type, schema } = Astro.props
const locale = getLocaleFromUrl(Astro.url)
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <script is:inline>
    (function(){
      if(localStorage.getItem('lang-pref'))return;
      if(location.pathname.startsWith('/en'))return;
      if((navigator.language||'').startsWith('en')){
        localStorage.setItem('lang-pref','en');
        var R={'/contacto':'/contact','/sobre-mi':'/about'},p=location.pathname,b=p.replace(/\/$/,''),t=R[b]?R[b]+(p.length>b.length?'/':''):p;
        location.replace('/en'+t);
      }else{localStorage.setItem('lang-pref','es')}
    })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
    />
    {schema && <JsonLd schema={schema} />}
    <ViewTransitions />
  </head>
  <body class="min-h-screen overflow-x-hidden flex flex-col">
    <!-- Intro de marca: síncrona para tapar la página desde el primer fotograma; una vez por sesión -->
    <script is:inline src="/intro/aw-intro.js"></script>
    <SiteHeader />
    <main class="flex-1 flex flex-col">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Vídeos en bucle (juegos): arrancan solo si no se pide reducir movimiento; si no, se queda el póster.
      const playLoops = () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => v.play().catch(() => {}))
      }
      document.addEventListener('astro:page-load', playLoops)
    </script>

  </body>
</html>
