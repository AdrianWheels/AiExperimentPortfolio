---
import BaseLayout from '../layouts/BaseLayout.astro'
import WorkCard from '../components/projects/WorkCard.astro'
import { getLocaleFromUrl, t } from '../i18n'
import { getProjects, byKind } from '../lib/projects'

const locale = getLocaleFromUrl(Astro.url)
const projects = await getProjects(locale)
const featured = projects.filter((p) => p.data.tier === 'featured')
const clients = byKind(featured, 'client')
const own = byKind(featured, 'own')
const more = projects.filter((p) => p.data.tier === 'more' && p.url && p.data.kind !== 'game')
---

<BaseLayout title={t(locale, 'seo.projects.title')} description={t(locale, 'seo.projects.description')}>
  <div class="page list">
    <header class="intro">
      <h1>{t(locale, 'projects.title')}</h1>
      <p>{t(locale, 'projects.intro')}</p>
    </header>


    <section id="trabajos" aria-labelledby="h-trabajos">
      <div class="head"><h2 id="h-trabajos">{t(locale, 'projects.clients')}</h2><span class="mono">{t(locale, 'projects.clientsNote')}</span></div>
      <div class="grid">{clients.map((w) => <WorkCard work={w} />)}</div>
    </section>

    {own.length > 0 && (
      <section id="propios" aria-labelledby="h-propios">
        <div class="head"><h2 id="h-propios">{t(locale, 'projects.own')}</h2></div>
        <div class="grid">{own.map((w) => <WorkCard work={w} />)}</div>
      </section>
    )}

    {more.length > 0 && (
      <section aria-labelledby="h-more">
        <div class="head"><h2 id="h-more">{t(locale, 'projects.more')}</h2></div>
        <ul class="more">
          {more.map((p) => (
            <li><a href={p.url!}><span class="mono">{p.data.year}</span><b>{p.data.title}</b><span class="d">{p.data.role}</span><span class="arr" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .list { padding-top: 48px; padding-bottom: 40px; }
  .intro h1 { font-weight: 200; font-size: clamp(40px, 5vw, 64px); letter-spacing: -0.025em; }
  .intro p { color: var(--dim); font-size: 17px; margin-top: 10px; max-width: 560px; }
  section { margin-top: 72px; scroll-margin-top: 90px; }
  .head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .head h2 { font-weight: 300; font-size: 26px; letter-spacing: -0.01em; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .more { list-style: none; padding: 0; margin: 0; }
  .more a { display: grid; grid-template-columns: 70px 220px 1fr 20px; gap: 16px; align-items: baseline; padding: 16px 4px; border-bottom: 1px solid var(--line); transition: background-color .2s; }
  .more a:hover { background: rgba(255,255,255,.02); }
  .more b { font-weight: 400; font-size: 16px; }
  .more .d { color: var(--dim); font-size: 14px; }
  .more .arr { color: var(--faint); }
  @media (max-width: 900px) {
    .list { padding-top: 28px; }
    .grid { grid-template-columns: 1fr; }
    .more a { grid-template-columns: 1fr 20px; gap: 4px 12px; }
    .more .mono { grid-column: 1 / -1; }
    .more .d { grid-column: 1; }
  }
</style>
