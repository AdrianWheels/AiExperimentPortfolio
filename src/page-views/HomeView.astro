---
import BaseLayout from '../layouts/BaseLayout.astro'
import Beam from '../components/home/Beam.astro'
import GameCta from '../components/projects/GameCta.astro'
import { getLocaleFromUrl, getLocalizedUrl, getContactUrl, getProfile, profileBase, t } from '../i18n'
import { getProjects, byKind } from '../lib/projects'

const locale = getLocaleFromUrl(Astro.url)
const L = (p: string) => getLocalizedUrl(locale, p)
const profile = getProfile(locale)
const projects = await getProjects(locale)
const [mainGame, ...otherGames] = byKind(projects, 'game')
const clients = byKind(projects, 'client').filter((p) => p.data.tier === 'featured')
const proofClients = clients.filter((p) => ['jr-fisioterapia', 'pepa-print3d'].includes(p.base))
const proofGame = otherGames[0]

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profileBase.name,
  jobTitle: t(locale, 'schema.jobTitle'),
  url: 'https://adrianrueda.dev',
  sameAs: profileBase.social.map((s) => s.url),
  address: { '@type': 'PostalAddress', addressLocality: 'Almería', addressCountry: 'ES' },
}
---

<BaseLayout title={t(locale, 'seo.home.title')} description={t(locale, 'seo.home.description')} schema={schema}>
  <div class="page home">
    <section class="tile hero" data-tile>
      <Beam />
      <div class="me">
        <img src="/me.webp" alt="" width="52" height="52" />
        <div>
          <div class="n">Adrián Rueda</div>
          <div class="mono">{t(locale, 'home.role')}</div>
        </div>
      </div>
      <h1>{t(locale, 'home.headlineA')} <b>{t(locale, 'home.headlineB')}</b>{t(locale, 'home.headlineC')}</h1>
      <div class="actions">
        <a class="btn btn-solid" href={getContactUrl(locale)}>{t(locale, 'home.ctaHire')}</a>
        <a class="btn" href={L('/projects')}>{t(locale, 'home.ctaProjects')}</a>
        <span class="mono avail"><span class="dot-live"></span>{t(locale, 'home.available')}</span>
      </div>
    </section>

    {mainGame && (
      <section class="tile games" data-tile>
        {mainGame.data.loop
          ? <video class="art" src={mainGame.data.loop} poster={mainGame.data.heroImage} data-autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
          : <img class="art" src={mainGame.data.heroImage} alt="" />}
        <div class="in">
          <span class="mono">{t(locale, 'home.gamesLabel')}</span>
          <div class="bottom">
            <span class="mono">{mainGame.data.genre} · {mainGame.data.platform}</span>
            <h2>{mainGame.data.title}</h2>
            <p>{mainGame.data.hook}</p>
            <div class="cta"><GameCta cta={mainGame.data.cta} /></div>
            <nav class="others">
              {otherGames.filter((g) => g.data.tier === 'featured').slice(0, 2).map((g) => g.url && <a href={g.url}>{g.data.title}</a>)}
              <a class="all" href={L('/juegos')}>{t(locale, 'home.gamesAll')} →</a>
            </nav>
          </div>
        </div>
      </section>
    )}

    <a class="tile offer" data-tile href={`${L('/projects')}#trabajos`}>
      <span class="mono">01</span>
      <h3>{t(locale, 'home.offer1Title')}</h3>
      <p>{t(locale, 'home.offer1Text')}</p>
      <div class="proof">
        {proofClients[0] && <img src={proofClients[0].data.heroImage} alt="" loading="lazy" />}
        <span>{t(locale, 'home.offer1Proof')} {proofClients.map((p, i) => <>{i > 0 && ', '}<b>{p.data.title}</b></>)}</span>
      </div>
    </a>
    <a class="tile offer" data-tile href={L('/juegos')}>
      <span class="mono">02</span>
      <h3>{t(locale, 'home.offer2Title')}</h3>
      <p>{t(locale, 'home.offer2Text')}</p>
      <div class="proof">
        {proofGame && <img src={proofGame.data.heroImage} alt="" loading="lazy" />}
        <span>{t(locale, 'home.offer2Proof')}</span>
      </div>
    </a>
  </div>
</BaseLayout>

<style>
  .home {
    flex: 1; width: 100%; display: grid; gap: 16px; padding-top: 24px; padding-bottom: 8px;
    grid-template-columns: 1.15fr 1fr 0.9fr;
    grid-template-rows: minmax(380px, 1fr) minmax(190px, auto);
    max-height: 760px;
  }

  .hero { grid-column: 1 / 3; grid-row: 1; padding: 40px; display: flex; flex-direction: column; justify-content: flex-end; border-color: var(--line2);
    background: radial-gradient(90% 80% at 75% 10%, rgba(255,255,255,.05), transparent 60%), rgba(255,255,255,.02); }
  .me { display: flex; align-items: center; gap: 14px; }
  .me img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; filter: grayscale(1); border: 1px solid var(--line2); }
  .me .n { font-size: 17px; font-weight: 400; }
  h1 { font-weight: 200; font-size: clamp(34px, 3.4vw, 46px); line-height: 1.06; letter-spacing: -0.025em; margin: 26px 0 30px; max-width: 620px; }
  h1 b { font-weight: 400; }
  .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .avail { margin-left: 14px; }

  .games { grid-column: 3; grid-row: 1 / 3; display: flex; }
  .games .art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .games::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(5,5,6,.55) 0%, transparent 22%, transparent 42%, rgba(5,5,6,.92) 78%); }
  .games .in { padding: 26px; display: flex; flex-direction: column; width: 100%; }
  .games .bottom { margin-top: auto; }
  .games h2 { font-weight: 300; font-size: 30px; letter-spacing: -0.01em; margin: 8px 0 6px; }
  .games p { color: #c9cad0; font-size: 14.5px; line-height: 1.45; }
  .games .cta { margin-top: 18px; }
  .others { display: flex; gap: 18px; margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--line2); font-size: 14px; }
  .others a { color: var(--dim); transition: color 0.2s; }
  .others a:hover { color: var(--ink); }
  .others .all { margin-left: auto; }

  .offer { grid-row: 2; padding: 26px; display: flex; flex-direction: column; }
  .offer h3 { font-weight: 400; font-size: 17px; margin: 10px 0 6px; }
  .offer p { color: var(--dim); font-size: 14px; line-height: 1.45; }
  .proof { margin-top: auto; padding-top: 16px; display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--dim); }
  .proof img { width: 54px; height: 34px; object-fit: cover; object-position: top; border-radius: 4px; border: 1px solid var(--line2); flex: none; }
  .proof b { color: var(--ink); font-weight: 400; }

  @media (max-width: 900px) {
    .home { display: flex; flex-direction: column; max-height: none; padding-top: 12px; }
    .hero { min-height: 72vh; padding: 28px; }
    .avail { margin: 10px 0 0; width: 100%; }
    .games { min-height: 460px; }
  }
</style>
