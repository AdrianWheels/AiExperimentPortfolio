---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLocaleFromUrl, getContactUrl, getProfile, profileBase, t } from '../i18n'

const locale = getLocaleFromUrl(Astro.url)
const profile = getProfile(locale)
const redirectUrl = `https://adrianrueda.dev${getContactUrl(locale)}`
const linkedin = profileBase.social.find((s) => s.label === 'LinkedIn')
---

<BaseLayout title={t(locale, 'seo.contact.title')} description={t(locale, 'seo.contact.description')}>
  <div class="page contact">
    <header class="intro">
      <span class="mono"><span class="dot-live"></span>{profile.availability}</span>
      <h1>{t(locale, 'contact.title')}</h1>
      <p>{t(locale, 'contact.subtitle')}</p>
    </header>

    <div class="layout">
      <form class="tile form" action={`https://formsubmit.co/${profileBase.contact.formSubmitId}`} method="POST">
        <input type="hidden" name="_subject" value="Nuevo contacto desde adrianrueda.dev" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={redirectUrl} />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <label><span class="mono">{t(locale, 'contact.name')}</span><input type="text" name="name" required autocomplete="name" placeholder={t(locale, 'contact.namePlaceholder')} /></label>
        <label><span class="mono">{t(locale, 'contact.email')}</span><input type="email" name="email" required autocomplete="email" placeholder={t(locale, 'contact.emailPlaceholder')} /></label>
        <label class="wide"><span class="mono">{t(locale, 'contact.subject')}</span><input type="text" name="subject" placeholder={t(locale, 'contact.subjectPlaceholder')} /></label>
        <label class="wide"><span class="mono">{t(locale, 'contact.message')}</span><textarea name="message" rows="6" required placeholder={t(locale, 'contact.messagePlaceholder')}></textarea></label>
        <div class="wide send"><button type="submit" class="btn btn-solid">{t(locale, 'contact.submit')}</button></div>
      </form>

      <aside class="side">
        <a class="tile direct" href={`mailto:${profileBase.contact.email}`}>
          <span class="mono">{t(locale, 'contact.direct')}</span>
          <b>{profileBase.contact.email}</b>
        </a>
        {linkedin && (
          <a class="tile direct" href={linkedin.url} target="_blank" rel="noopener">
            <span class="mono">LinkedIn</span><b>adrian-rueda ↗</b>
          </a>
        )}
        <dl class="facts">
          <div><dt class="mono">{t(locale, 'contact.locationLabel')}</dt><dd>{profile.location}</dd></div>
          <div><dt class="mono">{t(locale, 'contact.timezone')}</dt><dd>{profileBase.contact.timeZone}</dd></div>
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contact { padding-top: 48px; padding-bottom: 32px; }
  h1 { font-weight: 200; font-size: clamp(40px, 5vw, 64px); letter-spacing: -0.025em; margin: 10px 0 12px; }
  .intro p { color: #c9cad0; font-size: 19px; max-width: 600px; line-height: 1.55; }
  .layout { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; margin-top: 40px; align-items: start; }
  .form { padding: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .wide { grid-column: 1 / -1; }
  label { display: flex; flex-direction: column; gap: 8px; }
  input, textarea { background: rgba(255,255,255,.03); border: 1px solid var(--line2); border-radius: 10px; padding: 12px 14px; color: var(--ink); font: inherit; font-size: 15px; font-weight: 300; resize: vertical; transition: border-color .2s; }
  input::placeholder, textarea::placeholder { color: var(--faint); }
  input:focus, textarea:focus { outline: none; border-color: rgba(255,255,255,.5); }
  .send { display: flex; justify-content: flex-end; }
  button.btn { cursor: pointer; padding: 12px 24px; }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .direct { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .direct b { font-weight: 400; font-size: 17px; word-break: break-all; }
  .facts { margin: 8px 0 0; display: grid; gap: 14px; padding: 0 4px; }
  .facts dd { margin: 4px 0 0; color: #c9cad0; }
  @media (max-width: 900px) {
    .contact { padding-top: 28px; }
    .layout, .form { grid-template-columns: 1fr; }
  }
</style>
