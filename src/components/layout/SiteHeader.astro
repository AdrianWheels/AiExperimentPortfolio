---
import AwMark from './AwMark.astro'
import { getLocaleFromUrl, getLocalizedUrl, getAlternateLocaleUrl, getContactUrl, t } from '../../i18n'

const locale = getLocaleFromUrl(Astro.url)
const path = Astro.url.pathname
const L = (p: string) => getLocalizedUrl(locale, p)
const links = [
  { href: L('/juegos'), label: t(locale, 'nav.games'), match: locale === 'es' ? '/juegos' : '/games' },
  { href: L('/projects'), label: t(locale, 'nav.projects'), match: '/projects' },
  { href: L('/sobre-mi'), label: t(locale, 'nav.about'), match: locale === 'es' ? '/sobre-mi' : '/about' },
]
---
<header class="site-header">
  <div class="page bar">
    <a class="brand" href={L('/')} aria-label="Adrián Wheels · inicio">
      <AwMark width={28} />
      <span>Adrián Wheels</span>
    </a>
    <nav aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match && path.includes(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="lang mono" href={getAlternateLocaleUrl(locale, path)} title={t(locale, 'lang.switchTitle')} hreflang={locale === 'es' ? 'en' : 'es'}>{t(locale, 'lang.switch')}</a>
    <a class="btn cta" href={getContactUrl(locale)}>{t(locale, 'nav.cta')}</a>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgba(5, 5, 6, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .bar { display: flex; align-items: center; gap: 28px; height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 400; font-size: 15px; color: var(--ink); }
  nav { margin-left: auto; display: flex; gap: 26px; font-size: 14px; }
  nav a { color: var(--dim); transition: color 0.2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .lang { padding: 4px 2px; }
  .lang:hover { color: var(--ink); }
  .cta { padding: 7px 15px; font-size: 13px; font-weight: 500; }
  @media (max-width: 720px) {
    .bar { gap: 14px; height: 60px; }
    nav { gap: 14px; font-size: 13px; }
    nav a:last-child { display: none; }
    .brand span { display: none; }
    .cta { display: none; }
  }
</style>
