---
import { profile } from '../../data/profile'
---

<footer class="relative z-10 border-t border-white/5 bg-bgStart/80 backdrop-blur-sm mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <h3 class="text-lg font-bold text-white mb-2">{profile.name}</h3>
        <p class="text-sm text-gray-400 leading-relaxed">{profile.tagline}</p>
        <p class="text-xs text-gray-500 mt-2">{profile.location}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Navegación</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-sm text-gray-400 hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/projects" class="text-sm text-gray-400 hover:text-white transition-colors">Proyectos</a></li>
          <li><a href="/#timeline" class="text-sm text-gray-400 hover:text-white transition-colors">Experiencia</a></li>
          <li><a href="/contacto" class="text-sm text-gray-400 hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Contact CTA -->
      <div>
        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">¿Tienes un proyecto?</h4>
        <p class="text-sm text-gray-400 mb-4">Hablemos sobre cómo puedo ayudarte a crear algo único.</p>
        <a
          href="/contacto"
          class="inline-block text-sm font-semibold bg-purple-600 hover:bg-purple-500 text-white px-6 py-2.5 rounded-lg transition-colors"
        >
          Escríbeme
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        © {new Date().getFullYear()} {profile.name}. Desarrollado con Astro.
      </p>
      <div class="flex items-center gap-4">
        {profile.social.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noreferrer"
            class="text-xs text-gray-500 hover:text-white transition-colors"
          >
            {social.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
