---
import { t, getTimeline } from '../../i18n'
import type { Locale } from '../../i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const timeline = getTimeline(locale)
---

<div id="timeline" class="h-full flex flex-col relative">
  <div class="flex items-center gap-2 mb-4 px-2">
    <h3 class="text-xs font-bold tracking-widest text-gray-400 uppercase">{t(locale, 'timeline.title')}</h3>
  </div>

  <div class="flex-1 overflow-y-auto custom-scrollbar pr-2 space-y-4">
    {timeline.map((item) => (
      <div class="relative pl-4 border-l border-white/10">
        <div class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#13131f] border border-purple-500/50"></div>

        <div class="mb-1">
          <span class="text-[10px] font-mono text-purple-400">{item.period}</span>
          <h4 class="text-sm font-bold text-white">{item.role}</h4>
          <p class="text-xs text-gray-400">{item.company}</p>
        </div>

        <p class="text-[11px] text-gray-500 leading-relaxed">
          {item.summary}
        </p>
      </div>
    ))}
  </div>
</div>
