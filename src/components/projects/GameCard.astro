---
// Tarjeta cinematográfica de un juego: imagen o vídeo a sangre, género, nombre, frase y botón.
// Nunca muestra cómo está hecho (ver design/2026-10-20-rediseno-portfolio.md, antiobjetivos).
import GameCta from './GameCta.astro'
import type { Project } from '../../lib/projects'
interface Props { game: Project; big?: boolean }
const { game, big = false } = Astro.props
const d = game.data
---
<article class:list={['tile', 'game-card', { big, 'is-link': !!game.url }]}>
  {d.loop
    ? <video class="art" src={d.loop} poster={d.heroImage} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    : <img class="art" src={d.heroImage} alt="" loading="lazy" />}
  <div class="info">
    <span class="mono">{d.genre} · {d.platform}</span>
    <h3>{game.url ? <a href={game.url} class="stretch">{d.title}</a> : d.title}</h3>
    {d.hook && <p>{d.hook}</p>}
    {d.credit && <p class="credit mono">{d.credit}</p>}
    {d.cta && <div class="cta"><GameCta cta={d.cta} /></div>}
  </div>
</article>

<style>
  .game-card { min-height: 360px; display: flex; align-items: flex-end; }
  .game-card.big { min-height: 520px; }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .game-card:hover .art { transform: scale(1.03); }
  .game-card::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 35%, rgba(5,5,6,.9) 85%); }
  .info { padding: 28px; position: relative; }
  h3 { font-weight: 300; font-size: 30px; letter-spacing: -0.01em; margin: 8px 0 6px; }
  .big h3 { font-size: 40px; }
  p { color: #c9cad0; font-size: 15px; line-height: 1.45; max-width: 440px; }
  .credit { margin-top: 10px; color: var(--dim); text-transform: none; letter-spacing: .02em; font-size: 11.5px; }
  .cta { margin-top: 18px; position: relative; z-index: 2; }
  .stretch::after { content: ''; position: absolute; inset: -9999px; }
  .game-card { overflow: hidden; }
</style>
